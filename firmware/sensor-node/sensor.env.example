# Optional overrides for flash-sensor.sh. Copy to sensor.env (gitignored).
# You usually don't need this — the WiFi password is ALWAYS entered at flash time
# (never stored), and the API base defaults to the deployed Worker.

# SS_WIFI_SSID="FN-Hotspot"     # skip typing --ssid on every flash
# SS_API_BASE="https://sentry-sonar-api.francesconovy.workers.dev"
