{
  "name": "sentry-sonar",
  "version": "0.1.0",
  "private": true,
  "description": "Meeting-room presence detection with radar sensors, Cloudflare Workers/D1, e-ink displays, and a dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsentry/sentry-sonar-detection.git"
  },
  "homepage": "https://github.com/getsentry/sentry-sonar-detection#readme",
  "bugs": {
    "url": "https://github.com/getsentry/sentry-sonar-detection/issues"
  },
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy": "pnpm --filter dashboard build && pnpm --filter api run deploy"
  },
  "packageManager": "pnpm@10.34.5",
  "volta": {
    "node": "26.7.0",
    "pnpm": "10.34.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
